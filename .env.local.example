# Site mode: set to "coming_soon" for temporary landing; unset for full site (server-only)
# SITE_MODE=coming_soon

# Email (Resend) — vidi RESEND_SETUP.md (source of truth)
# API kljuc "odontoa-website" sa "Sending access" iz Resend dashboarda. Pravi kljuc nikad u repo.
RESEND_API_KEY=
# Posiljalac; mora biti na domenu verifikovanom u Resend-u (notify.odontoa.com)
RESEND_FROM_EMAIL=Odontoa Forms <forms@notify.odontoa.com>
# Interni primaoci obavestenja o formama, razdvojeni zarezom.
# Ako se izostavi, koristi se ista lista iz src/lib/email.ts.
CONTACT_TO_EMAIL=info@odontoa.com,ognjen.drinic31@gmail.com
