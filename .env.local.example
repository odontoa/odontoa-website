# Posiljalac; mora biti na domenu verifikovanom u Resend-u (odontoa.info)
RESEND_FROM_EMAIL=Odontoa <noreply@odontoa.info>
# Interni primaoci obavestenja o formama, razdvojeni zarezom.
# Ako se izostavi, koristi se lista iz src/lib/email.ts.
CONTACT_TO_EMAIL=info@odontoa.info,ognjen.drinic31@gmail.com
